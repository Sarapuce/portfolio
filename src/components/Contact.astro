---
import { site } from "../data/site";

// Quand il est dispo, le badge du hero le dit déjà. On ne le répète que si ça
// change la décision d'écrire, donc uniquement quand il ne l'est pas.
---

<section id="contact" class="max-w-5xl mx-auto px-6 py-24 lg:py-32">
  <div class="border-t border-line pt-16">
    <h2
      class:list={[
        "font-display font-medium text-4xl sm:text-5xl text-bone leading-tight max-w-xl",
        site.disponible ? "mb-12" : "mb-6",
      ]}
    >
      {site.phraseContact}
    </h2>
    {
      !site.disponible && (
        <p class="text-indispo mb-12 max-w-lg">{site.texteIndispo}.</p>
      )
    }

    <a
      href={`mailto:${site.email}`}
      class="inline-block font-display font-medium text-2xl sm:text-3xl text-bone border-b border-accent pb-1 hover:text-accent transition-colors"
    >
      {site.email}
    </a>

    <div class="mt-20 flex flex-wrap items-center justify-between gap-6 text-sm">
      <div class="flex gap-8">
        <a href={site.linkedin} target="_blank" rel="noopener" class="hover:text-bone transition-colors">
          LinkedIn
        </a>
        <a href={site.github} target="_blank" rel="noopener" class="hover:text-bone transition-colors">
          GitHub
        </a>
        <a href={site.rootme} target="_blank" rel="noopener" class="hover:text-bone transition-colors">
          Root-Me
        </a>
      </div>
      <p class="text-muted/50">© {new Date().getFullYear()} {site.nom}</p>
    </div>
  </div>
</section>
