---
import { site } from "../data/site";
import { categories } from "../data/categories";
---

<header class="sticky top-0 z-40 bg-base/70 backdrop-blur-md">
  <nav class="max-w-5xl mx-auto px-6">
    <div class="flex items-center justify-between h-20 border-b border-line">
      <a
        href="/"
        class="text-bone text-sm font-medium tracking-[0.18em] uppercase hover:text-accent transition-colors"
      >
        {site.nom}
      </a>

      <div class="hidden md:flex items-center gap-8 text-sm">
        {
          categories.map((c) => (
            <a href={`/#${c.id}`} class="hover:text-bone transition-colors">
              {c.label}
            </a>
          ))
        }
        <a
          href="/#contact"
          class="text-bone border-b border-accent pb-0.5 hover:text-accent transition-colors"
        >
          Contact
        </a>
      </div>

      <button id="menu-btn" class="md:hidden text-bone" aria-label="Menu">
        <span id="menu-icon" class="block text-sm tracking-widest uppercase">Menu</span>
      </button>
    </div>

    <div id="menu" class="hidden md:hidden py-6 space-y-4 border-b border-line">
      {
        categories.map((c) => (
          <a href={`/#${c.id}`} class="block text-bone text-lg">
            {c.label}
          </a>
        ))
      }
      <a href="/#contact" class="block text-accent text-lg">Contact</a>
    </div>
  </nav>
</header>

<script>
  const brancher = () => {
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("menu");
    const icon = document.getElementById("menu-icon");
    if (!btn || !menu || !icon) return;

    const toggle = () => {
      menu.classList.toggle("hidden");
      icon.textContent = menu.classList.contains("hidden") ? "Menu" : "Fermer";
    };

    btn.addEventListener("click", toggle);
    menu.querySelectorAll("a").forEach((lien) =>
      lien.addEventListener("click", () => {
        if (!menu.classList.contains("hidden")) toggle();
      }),
    );
  };

  brancher();
  document.addEventListener("astro:page-load", brancher);
</script>
