---
import type { Categorie } from "../data/categories";
import { lienDe, type Mission } from "../data/missions";

interface Props {
  mission: Mission;
  categorie: Categorie;
}

const { mission, categorie } = Astro.props;
const { titre, badge, resume, constats, conclusion, tags } = mission.data;
const c = categorie.couleur;
---

<article
  class:list={[
    "group bg-surface rounded-xl border border-line transition-all duration-300 hover:-translate-y-1 p-8 flex flex-col",
    c.bordure,
  ]}
>
  <div class="flex items-start justify-between gap-4 mb-5">
    <h3 class="text-xl font-bold text-white transition-colors">{titre}</h3>
    <span
      class:list={["shrink-0 text-xs font-mono py-1 px-2 rounded border", c.badge]}
    >
      {badge}
    </span>
  </div>

  <p class="text-sm text-slate-400 mb-5">{resume}</p>

  {
    constats.length > 0 && (
      <ul class="text-sm text-slate-400 space-y-2 mb-6">
        {constats.map((p) => (
          <li class="flex gap-2">
            <span class={c.puce}>➜</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    )
  }

  <div class:list={["bg-base/60 border-l-4 p-4 mb-6", c.barre]}>
    <p class:list={["text-xs font-bold uppercase mb-1", c.texte]}>Constat</p>
    <p class="text-sm text-slate-300">{conclusion}</p>
  </div>

  <a
    href={lienDe(mission)}
    class:list={[
      "inline-flex items-center gap-2 self-start px-5 py-2.5 rounded-lg border font-semibold text-sm transition-all mb-6",
      c.bouton,
    ]}
  >
    Lire l'audit
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M14 5l7 7-7 7M3 12h18"></path>
    </svg>
  </a>

  <div class="flex flex-wrap gap-2 mt-auto">
    {
      tags.map((t) => (
        <span class="text-xs font-mono text-slate-500 bg-line px-2 py-1 rounded">
          {t}
        </span>
      ))
    }
  </div>
</article>
