---
import type { Categorie } from "../data/categories";
import { missionsDe } from "../data/missions";
import MissionCard from "./MissionCard.astro";

interface Props {
  categorie: Categorie;
  numero: number;
}

const { categorie, numero } = Astro.props;
const missions = await missionsDe(categorie.id);
const num = String(numero).padStart(2, "0");
---

<section id={categorie.id} class="border-t border-line py-20 lg:py-24">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-3">
      <span class={categorie.couleur.texte}>{num}.</span>
      {categorie.label}
    </h2>
    <p class="text-slate-400 max-w-2xl mb-12">{categorie.tagline}</p>

    <div class="grid md:grid-cols-2 gap-6">
      {
        missions.map((m) => (
          <MissionCard mission={m} categorie={categorie} />
        ))
      }
    </div>
  </div>
</section>
