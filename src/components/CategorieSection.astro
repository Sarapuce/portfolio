---
import type { Categorie } from "../data/categories";
import { missionsDe } from "../data/missions";
import MissionRow from "./MissionRow.astro";

interface Props {
  categorie: Categorie;
}

const { categorie } = Astro.props;
const missions = await missionsDe(categorie.id);
---

<section
  id={categorie.id}
  class="max-w-5xl mx-auto px-6 pt-12 pb-20 lg:pt-14 lg:pb-24"
>
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
    <h2 class="flex items-center gap-3 text-xs tracking-[0.2em] uppercase text-bone">
      <span class:list={["w-1.5 h-1.5 rounded-full", categorie.couleur.point]}></span>
      {categorie.label}
    </h2>
    <p class="text-sm text-muted max-w-lg md:text-right">{categorie.tagline}</p>
  </div>

  <div class="border-b border-line">
    {missions.map((m) => <MissionRow mission={m} categorie={categorie} />)}
  </div>
</section>
