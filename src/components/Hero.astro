---
import { site } from "../data/site";
import { categories } from "../data/categories";

const premiere = categories[0];

// Classes écrites en entier, Tailwind ne verrait pas une variante construite à la volée
const badge = site.disponible
  ? "border-dispo/30 bg-dispo/10 text-dispo"
  : "border-indispo/30 bg-indispo/10 text-indispo";
const point = site.disponible ? "bg-dispo" : "bg-indispo";
const statut = site.disponible ? site.texteDispo : site.texteIndispo;

const termData = JSON.stringify({
  whoami: site.terminal.roles,
  fichiers: {
    "stack.txt": site.terminal.stack,
    "certifs.txt": site.terminal.certifs,
    "flag.txt": ["SARAPUCE{3asY_fl4G}"],
  },
  secret: {
    ilovesarapuce: ["SARAPUCE{m3diUm_fl4g}"],
  },
});
---

<section id="profil" class="max-w-5xl mx-auto px-6 pt-14 pb-10 lg:pt-20 lg:pb-12">
  <div class="grid lg:grid-cols-[1.15fr_1fr] gap-12 lg:gap-16 items-center">
    <div>
      <p
        class:list={[
          "inline-flex items-center gap-2.5 mb-10 pl-3 pr-4 py-2 rounded-full border text-[13px] font-medium tracking-[0.14em] uppercase",
          badge,
        ]}
      >
        <span class="relative flex w-2 h-2 shrink-0">
          {
            site.disponible && (
              <span class="absolute inline-flex w-full h-full rounded-full bg-dispo opacity-75 animate-ping motion-reduce:hidden" />
            )
          }
          <span class:list={["relative inline-flex w-2 h-2 rounded-full", point]}></span>
        </span>
        {statut}
      </p>

      <h1
        class="font-display font-medium text-bone text-5xl sm:text-6xl lg:text-7xl leading-[0.98] tracking-tight mb-8"
      >
        {site.titre}
      </h1>

      <p class="text-lg text-muted max-w-md mb-4">{site.accroche}</p>
      <p class="text-muted max-w-md mb-10">{site.bio}</p>

      <div class="flex flex-wrap items-center gap-x-8 gap-y-4 text-sm">
        <a
          href="#contact"
          class="text-bone border-b border-accent pb-1 hover:text-accent transition-colors"
        >
          Me contacter
        </a>
        <a href={site.cv} class="hover:text-bone transition-colors">
          CV
        </a>
        <a href={site.github} target="_blank" rel="noopener" class="hover:text-bone transition-colors">
          GitHub
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener" class="hover:text-bone transition-colors">
          LinkedIn
        </a>
        <a href={site.rootme} target="_blank" rel="noopener" class="hover:text-bone transition-colors">
          Root-Me
        </a>
      </div>
    </div>

    <div class="rounded-md bg-surface border border-line overflow-hidden">
      <div class="flex items-center gap-1.5 px-4 py-3 border-b border-line">
        <span class="w-2 h-2 rounded-full bg-line"></span>
        <span class="w-2 h-2 rounded-full bg-line"></span>
        <span class="w-2 h-2 rounded-full bg-line"></span>
        <span class="ml-2 text-[11px] font-mono text-muted/60">~/sarapuce</span>
      </div>
      <div id="term-body" class="p-5 font-mono text-[13px] leading-6 max-h-[32rem] overflow-y-auto">
        <p><span class="text-muted/50">$&nbsp;</span><span class="text-accent">whoami</span></p>
        {site.terminal.roles.map((r) => <p class="text-bone">{r}</p>)}

        <p class="mt-6">
          <span class="text-muted/50">$&nbsp;</span><span class="text-accent">cat stack.txt</span>
        </p>
        {site.terminal.stack.map((l) => <p class="text-bone">{l}</p>)}

        <p class="mt-6">
          <span class="text-muted/50">$&nbsp;</span><span class="text-accent">cat certifs.txt</span>
        </p>
        {site.terminal.certifs.map((l) => <p class="text-bone">{l}</p>)}

        <div id="term-output"></div>

        <form id="term-form" class="flex items-center mt-6" autocomplete="off">
          <span class="text-muted/50">$&nbsp;</span>
          <input
            id="term-input"
            type="text"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            aria-label="Terminal interactif"
            class="flex-1 min-w-0 bg-transparent border-0 outline-none text-accent caret-accent font-mono text-[13px] p-0"
          />
        </form>

        <script type="application/json" id="term-data" set:html={termData} is:inline></script>
      </div>
    </div>
  </div>

  <a
    href={`#${premiere.id}`}
    class="mt-10 lg:mt-12 inline-flex items-center gap-3 text-xs tracking-[0.2em] uppercase hover:text-bone transition-colors"
  >
    Les audits
    <span class="indice-scroll">↓</span>
  </a>
</section>

<script>
  (function () {
    const boot = () => {
      const form = document.getElementById("term-form");
      if (!form || (form as HTMLElement).dataset.ready) return;
      const input = document.getElementById("term-input") as HTMLInputElement | null;
      const out = document.getElementById("term-output");
      const body = document.getElementById("term-body");
      const dataEl = document.getElementById("term-data");
      if (!input || !out || !body || !dataEl) return;
      (form as HTMLElement).dataset.ready = "1";

      const data = JSON.parse(dataEl.textContent || "{}");
      const fichiers: Record<string, string[]> = data.fichiers || {};
      const whoami: string[] = data.whoami || [];
      const secret: Record<string, string[]> = data.secret || {};

      const ligne = (texte: string, cls: string) => {
        const p = document.createElement("p");
        p.className = cls;
        p.textContent = texte;
        return p;
      };

      const executer = (brut: string) => {
        const bloc = document.createElement("div");
        bloc.className = "mt-6";

        const echo = document.createElement("p");
        const invite = document.createElement("span");
        invite.className = "text-muted/50";
        invite.textContent = "$ ";
        const cmd = document.createElement("span");
        cmd.className = "text-accent";
        cmd.textContent = brut;
        echo.append(invite, cmd);
        bloc.append(echo);

        const args = brut.trim().split(/\s+/).filter(Boolean);
        const nom = args[0];

        if (nom === "clear") {
          out.replaceChildren();
          return;
        }
        if (nom === "whoami") {
          whoami.forEach((l) => bloc.append(ligne(l, "text-bone")));
        } else if (nom === "ls") {
          bloc.append(ligne(Object.keys(fichiers).join("  "), "text-bone"));
        } else if (nom === "cat") {
          const cibles = args.slice(1);
          if (cibles.length === 0) {
            bloc.append(ligne("cat: missing file operand", "text-muted/60"));
          } else {
            cibles.forEach((f) => {
              if (fichiers[f]) {
                fichiers[f].forEach((l) => bloc.append(ligne(l, "text-bone")));
              } else {
                bloc.append(ligne("cat: " + f + ": No such file or directory", "text-muted/60"));
              }
            });
          }
        } else if (nom === "help") {
          bloc.append(ligne("commandes : ls, cat, whoami, clear", "text-muted/60"));
        } else if (nom && secret[nom]) {
          secret[nom].forEach((l) => bloc.append(ligne(l, "text-accent")));
        } else if (nom) {
          bloc.append(ligne("zsh: command not found: " + nom, "text-muted/60"));
        }

        out.append(bloc);
      };

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const val = input.value;
        input.value = "";
        executer(val);
        body.scrollTop = body.scrollHeight;
      });

      body.addEventListener("click", () => {
        if (String(window.getSelection() || "") === "") input.focus();
      });
    };

    boot();
    document.addEventListener("astro:page-load", boot);
  })();
</script>
