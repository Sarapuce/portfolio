---
import { site } from "../data/site";
---

<section id="profil" class="max-w-6xl mx-auto px-4 py-20 lg:py-28">
  <div class="grid lg:grid-cols-2 gap-14 items-center">
    <div>
      <span
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-finops/10 text-finops border border-finops/20 mb-6"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-finops"></span>
        Disponible pour des missions
      </span>

      <h1 class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-6">
        {site.titre}
      </h1>

      <p class="text-lg text-slate-400 mb-4">{site.accroche}</p>
      <p class="text-slate-400 mb-8">{site.bio}</p>

      <div class="flex flex-wrap gap-3">
        <a
          href={site.cv}
          target="_blank"
          class="flex items-center gap-2 py-3 px-5 rounded-lg bg-surface border border-line text-white font-medium hover:border-slate-600 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2z"
            ></path>
          </svg>
          CV
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-2 py-3 px-5 rounded-lg bg-surface border border-line text-white font-medium hover:border-slate-600 transition-colors"
        >
          GitHub
        </a>
        <a
          href="#contact"
          class="py-3 px-5 rounded-lg bg-accent text-base font-bold hover:bg-cyan-400 transition-colors shadow-lg shadow-accent/20"
        >
          Me contacter
        </a>
      </div>
    </div>

    <div class="rounded-xl bg-black border border-line overflow-hidden shadow-2xl">
      <div class="flex items-center gap-2 px-4 py-3 border-b border-line bg-surface">
        <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
        <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
        <span class="ml-2 text-xs font-mono text-slate-500">~/profil</span>
      </div>
      <div class="p-6 font-mono text-sm leading-7">
        <p><span class="text-slate-600">$</span> <span class="text-accent">whoami</span></p>
        <p class="text-slate-300 mb-4">{site.terminal.role}</p>

        <p><span class="text-slate-600">$</span> <span class="text-accent">cat stack.txt</span></p>
        {site.terminal.stack.map((l) => <p class="text-slate-300">{l}</p>)}

        <p class="mt-4">
          <span class="text-slate-600">$</span>
          <span class="text-accent">cat certifs.txt</span>
        </p>
        {site.terminal.certifs.map((l) => <p class="text-slate-300">{l}</p>)}

        <p class="mt-4">
          <span class="text-slate-600">$</span> <span class="animate-pulse">▊</span>
        </p>
      </div>
    </div>
  </div>
</section>
