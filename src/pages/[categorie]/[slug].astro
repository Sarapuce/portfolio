---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import { getCategorie, libellesDe } from "../../data/categories";
import { categorieDe, slugDe } from "../../data/missions";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const missions = await getCollection("missions");
  return missions.map((m) => ({
    params: { categorie: categorieDe(m), slug: slugDe(m) },
    props: { mission: m },
  }));
}

const { mission } = Astro.props;
const categorie = getCategorie(categorieDe(mission))!;
const c = categorie.couleur;
const { titre, resume, tags } = mission.data;
const d = mission.data;
const { Content } = await render(mission);

const lib = libellesDe(categorie);

const meta = [
  { cle: lib.perimetre, val: d.perimetre, detail: d.perimetreDetail, accent: false },
  { cle: lib.duree, val: d.duree, detail: d.dureeDetail, accent: false },
  { cle: lib.verdict, val: d.verdict, detail: d.verdictDetail, accent: true },
].filter((m) => m.val);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: titre,
  description: resume,
  url: new URL(Astro.url.pathname, Astro.site).href,
  author: { "@type": "Person", name: site.nom, url: "https://sarapuce.fr" },
  publisher: { "@type": "Person", name: site.nom },
  keywords: tags.join(", "),
  ...(d.date ? { datePublished: d.date } : {}),
};
---

<Base title={`${titre} — ${site.nom}`} description={resume} ogType="article">
  <Nav />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />


  <article class="max-w-3xl mx-auto px-6 py-20">
    <a
      href={`/#${categorie.id}`}
      class="inline-flex items-center gap-2.5 text-xs tracking-[0.2em] uppercase hover:text-bone transition-colors mb-12"
    >
      <span class:list={["w-1.5 h-1.5 rounded-full", c.point]}></span>
      {categorie.label}
    </a>

    <h1
      class="font-display font-medium text-4xl sm:text-5xl lg:text-6xl text-bone leading-[1.05] tracking-tight mb-6"
    >
      {titre}
    </h1>
    <p class="text-lg text-muted max-w-2xl mb-14">{resume}</p>

    {
      meta.length > 0 && (
        <dl class="grid sm:grid-cols-3 gap-px bg-line border border-line rounded-md overflow-hidden mb-4">
          {meta.map((m) => (
            <div class="bg-base p-5">
              <dt class="text-[11px] tracking-[0.15em] uppercase text-muted/60 mb-2">
                {m.cle}
              </dt>
              <dd class:list={[m.accent ? c.texte : "text-bone", "font-medium"]}>
                {m.val}
                {m.detail && (
                  <span class="block mt-1 text-xs font-normal text-muted/60">
                    {m.detail}
                  </span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      )
    }

    <p class="mt-12 mb-2 text-xl sm:text-2xl text-bone leading-snug max-w-2xl">
      {d.conclusion}
    </p>

    <div class="prose">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <div class="mt-20 pt-8 border-t border-line flex flex-wrap gap-x-3 gap-y-2 text-xs font-mono text-muted/60">
          {tags.map((t, i) => (
            <span>
              {i > 0 && "· "}
              {t}
            </span>
          ))}
        </div>
      )
    }
  </article>
</Base>
